# Digiinn360 website settings.
# `python install.py` creates .env from this file and fills in what it can.
# Never share .env or put it inside public_html.

# --- Required ------------------------------------------------------------------
# Your domain without https://, e.g. digiinn360.com
SITE_DOMAIN=
# From cPanel > MySQL Databases (cPanel adds your account prefix, e.g. cpuser_site)
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Filled in automatically by setup.py ---------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=

# --- Email alerts for new inquiries (optional but recommended) ---------------------
# Create a mailbox in cPanel > Email Accounts, e.g. no-reply@yourdomain.com,
# then use the "Outgoing Server" details cPanel shows for it.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Who receives the alerts (comma separated). Can be changed later in the admin.
LEADS_NOTIFY_EMAILS=info@digiinn360.com

# --- Optional ------------------------------------------------------------------------
# Admin panel address: https://yourdomain/<DJANGO_ADMIN_PATH>/
DJANGO_ADMIN_PATH=digibe
# Restrict the admin to office IPs (comma separated, CIDR allowed). Empty = anywhere.
ADMIN_ALLOWED_IPS=
# Only if the domain is proxied through Cloudflare (orange cloud), uncomment all three:
# CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# TRUSTED_PROXY_CIDRS=cloudflare
# TRUST_X_FORWARDED_PROTO=true
# Anti-bot puzzle strength (raise to 200000 during a spam wave). See SECURITY.md.
POW_MAX_NUMBER=50000
# Keep these unless you know you need to change them.
DB_HOST=localhost
DB_PORT=3306
DJANGO_DEBUG=false
